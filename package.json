{
  "name": "cs-courses",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "mdast-util-to-hast": "13.2.1",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev",
    "data:generate": "tsx scripts/generate-course-search-index.ts && tsx scripts/generate-course-seo-data.ts",
    "build": "npm run data:generate && next build --webpack",
    "build:cf": "npm run data:generate && opennextjs-cloudflare build",
    "preview:cf": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy:cf": "npm run build:cf && opennextjs-cloudflare deploy",
    "cf:dev": "npm run build:cf && wrangler dev",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply cs-courses --local",
    "db:migrate:prod": "wrangler d1 migrations apply cs-courses --remote",
    "start": "next start",
    "lint": "eslint",
    "test:seo": "tsx --test tests/seo.test.ts tests/course-links.test.ts tests/course-update-workflow.test.ts tests/course-rendering.test.tsx tests/course-anchors.test.tsx tests/course-facts.test.tsx",
    "test:analytics": "tsx --test tests/analytics.test.ts tests/analytics-route.test.ts tests/analytics-client.test.ts tests/analytics-retention.test.ts tests/rate-limit.test.ts tests/page-views.test.ts tests/page-view-route.test.ts tests/page-view-middleware.test.ts",
    "test:admin": "tsx --test tests/admin-session.test.ts tests/login-throttle.test.ts tests/admin-guard.test.ts",
    "test:gaps": "tsx --test tests/searchGaps.test.ts tests/searchGapIndex.test.ts tests/searchGapCache.test.ts",
    "test:ui": "tsx --test tests/ui-regressions.test.tsx",
    "courses:links": "node scripts/audit-course-links.mjs",
    "courses:sync": "node scripts/sync-course-feeds.mjs",
    "courses:sync:check": "node scripts/sync-course-feeds.mjs --check"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.12",
    "@next/third-parties": "^16.2.12",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/mdx": "^2.0.13",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.555.0",
    "marked": "^16.2.1",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rehype-highlight": "^7.0.2",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-code-titles": "^0.1.2",
    "remark-gfm": "^4.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^27.0.1",
    "miniflare": "5.20260730.0-alpha",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  }
}
